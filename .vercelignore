# Vercel: keep the serverless function bundle lean (things below are never
# needed at runtime and only bloat the function / risk build errors).

# Local Python tooling & envs
.venv/
venv/
env/
__pycache__/
*.py[cod]

# Local databases & scratch data
*.db
*.db-journal
*.sqlite3
*.sqlite3-journal
scratch/

# Test / repo tooling not needed in production
tests/
.vercel/
